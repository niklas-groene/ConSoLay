{
  "format": "cbl-rules",
  "formatVersion": 1,
  "id": "trn:motif-style",
  "revision": 1,
  "name": "Transcription network: regulators above targets",
  "description": "House style for transcription networks after Shen-Orr et al. (2002): regulators above the genes they regulate, the targets of a local regulator in one row, mutually regulating regulators side by side. The node attribute trn.regulator marks global and local regulators.",
  "rules": [
    {
      "id": "r1",
      "name": "Mutual regulation",
      "description": "Wins over Regulation for the two arcs of the pair.",
      "enabled": true,
      "priority": "HIGH",
      "template": {
        "id": "trn:mutual-regulation",
        "revision": 1,
        "name": "Mutual regulation"
      }
    },
    {
      "id": "r2",
      "name": "Regulation",
      "description": "The convention itself.",
      "enabled": true,
      "priority": "NORMAL",
      "template": {
        "id": "trn:regulation",
        "revision": 1,
        "name": "Regulation"
      }
    },
    {
      "id": "r3",
      "name": "Shared regulator",
      "description": "Yields to Regulation where a target regulates another target of the same regulator.",
      "enabled": true,
      "priority": "LOW",
      "template": {
        "id": "trn:shared-regulator",
        "revision": 1,
        "name": "Shared regulator"
      }
    }
  ],
